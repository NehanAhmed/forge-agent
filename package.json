{
  "name": "@nehanahmed/forge",
  "version": "0.2.0",
  "description": "A Terminal-based AI agent that can perform tasks and interact with the user.",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run clean && tsc && npm run postbuild",
    "postbuild": "node ./scripts/add-shebang.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "dev": "tsx watch src/cli/app.tsx --onSuccess \"node ./scripts/add-shebang.js\""
  },
  "bin": {
    "forge": "./dist/cli/app.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "multi-model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NehanAhmed/forge-agent.git"
  },
  "author": "Nehan Ahmed",
  "files": [
    "dist",
    "README.MD",
    "LICENSE"
  ],
  "type": "module",
  "dependencies": {
    "@openrouter/agent": "^0.11.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-gradient": "^4.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "string-width": "^8.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
