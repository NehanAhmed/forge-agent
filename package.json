{
  "name": "@nehanahmed/forge",
  "version": "0.1.3",
  "description": "A Terminal-based AI agent that can perform tasks and interact with the user.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && npm run postbuild",
    "postbuild": "node ./scripts/add-shebang.js",
    "prepare": "npm run build",
    "eval": "tsx evals/runner.ts",
    "dev": "tsx watch src/cli/app.tsx --onSuccess \"node ./scripts/add-shebang.js\""
  },
  "bin": {
    "forge": "./dist/cli/app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "multi-model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NehanAhmed/forge-agent.git"
  },
  "author": "Nehan Ahmed",
  "files": [
    "dist",
    "README.MD",
    "LICENSE"
  ],
  "type": "module",
  "dependencies": {
    "@openrouter/agent": "^0.11.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18"
  }
}
