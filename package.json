{
  "name": "@nehanahmed/forge",
  "version": "0.2.1",
  "description": "Task-oriented AI coding agent for the terminal: worktree-isolated tasks, approval-gated tools, and a live dashboard.",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --unit",
    "test:integration": "node scripts/run-tests.mjs --integration",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.{js,ts}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "npm run clean && tsc && npm run postbuild",
    "postbuild": "node ./scripts/add-shebang.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "dev": "tsx watch src/cli/app.tsx --onSuccess \"node ./scripts/add-shebang.js\""
  },
  "bin": {
    "forge": "./dist/cli/app.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "multi-model",
    "tui",
    "worktree",
    "openrouter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NehanAhmed/forge-agent.git"
  },
  "author": "Nehan Ahmed",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "dependencies": {
    "@openrouter/agent": "^0.11.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-gradient": "^4.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "string-width": "^8.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
